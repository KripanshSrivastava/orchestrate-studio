# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=idp
KEYCLOAK_CLIENT_ID=idp-backend
KEYCLOAK_ALLOWED_AUDIENCES=idp-backend,idp-frontend
KEYCLOAK_CLIENT_SECRET=H8dJqSHgQsDEUnIkv1fulM0GLf4GkIj6
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp_db
DB_USER=idp_user
DB_PASSWORD=secure_password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenBao secret storage
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
OPENBAO_KV_MOUNT=secret
OPENBAO_PATH_PREFIX=idp
SECRET_STORE_PROVIDER=openbao
SECRET_STORE_REQUIRE_REMOTE=true

# Optional HashiCorp Vault secret storage
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_PATH_PREFIX=idp

# Optional provider cards (write adapters not enabled yet)
AWS_REGION=
KUBERNETES_API_URL=
AZURE_KEY_VAULT_URL=

# JWT Secret (for token validation)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Server
NODE_ENV=development
PORT=3000

#Github Weebhook Secret
GITHUB_WEBHOOK_SECRET=test-secret
