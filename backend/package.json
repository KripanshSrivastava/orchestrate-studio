{
  "name": "orchestrate-studio-backend",
  "version": "1.0.0",
  "description": "Backend API for Internal Developer Platform",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "openbao:up": "docker compose -f docker/docker-compose.yml up -d openbao",
    "openbao:logs": "docker compose -f docker/docker-compose.yml logs -f openbao",
    "openbao:status": "docker compose -f docker/docker-compose.yml exec openbao bao status",
    "db:migrate": "tsx database/migrations/runMigrations.ts",
    "db:check": "tsx -e \"import { checkDatabaseConnection } from './database/pool.ts'; checkDatabaseConnection().then((ok) => { console.log(ok ? 'Database connection OK' : 'Database connection failed'); process.exit(ok ? 0 : 1); });\""
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bullmq": "^5.58.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "node-rsa": "^1.1.1",
    "octokit": "^5.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.15.5",
    "@types/node-rsa": "^1.1.4",
    "@types/swagger-ui-express": "^4.1.6",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
